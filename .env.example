# ─────────────────────────────────────────────────────────────
# Tsync — Mandatory Modular Architecture Configuration
# ─────────────────────────────────────────────────────────────

# Database: SQLite for zero-config local run, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./tsync.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tsync

# Ingestion: Telegram User Client (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=tsync_session

# Notifications & Bot: Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# AI Provider: OpenRouter (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Notifications: Meta WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=

# Operational Defaults
TIMEZONE=Asia/Kolkata
BREAKING_SCORE=8.5
IMPORTANCE_THRESHOLD=7.0
ENVIRONMENT=development
